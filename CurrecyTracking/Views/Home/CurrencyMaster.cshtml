@model List<CurrecyTracking.Models.CurrencyModel>
@{
    ViewData["title"] = "Currency Master";
}
<div class="text-center">
    <div class="card">
        <div class="card-header">
            <div class="d-flex justify-content-between">
                <span class="card-title">
                    <i class="fas fa-dollar-sign"></i> Currency Master
                </span>
                <button type="button" class="btn btn-primary btn-sm">
                    <i class="fas fa-plus"></i> Add Currency
                </button>
            </div>
        </div>
        <div class="card-body">
            <table id="tableCurrency" class="table table-bordered table-hover table-striped">
                <thead>
                    <tr>
                        <th style="width:15%">Code</th>
                        <th style="width:50%">Currency Name</th>
                        <th style="width:15%">Status</th>
                        <th style="width:20%">Action</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var currency in Model)
                    {
                        <tr>
                            <td>@currency.CurrencyCode</td>
                            <td style="text-align:left">
                                @currency.CurrencyName
                            </td>
                            <td>@currency.IsActive</td>
                            <td>
                                <button type="button" class="btn btn-warning">
                                    <i class="fas fa-edit"></i> Edit
                                </button>
                                <button type="button" class="btn btn-danger">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Edit modal -->
<div class="modal fade" id="editCurrencyModal" tabindex="-1" aria-labelledby="editCurrencyTitle" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form action="@Url.Action("EditCurrency", "Home")" method="post">
                @Html.AntiForgeryToken()
                <div class="modal-header">
                    <h5 class="modal-title" id="editCurrencyTitle">
                        Edit Currency
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">
                    <div class="mb-3">
                        <label for="editCode" class="form-label">Code</label>
                        <input id="editCode" name="CurrencyCode" class="form-control" readonly />
                    </div>
                    <div class="mb-3">
                        <label for="editName" class="form-label">
                            Currency Name
                        </label>
                        <input id="editName" name="CurrencyName" class="form-control" required />
                    </div>
                    <div class="form-check">
                        <input type="checkbox" id="editActive" name="IsActive" value="true" class="form-check-input" />
                        <label for="editActive" class="form-check-label">Active</label>
                    </div>
                    <input type="hidden" name="IsActive" value="false" />
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-save"></i> Save
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Delete modal -->
<div class="modal fade" id="deleteCurrencyModal" tabindex="-1"
     aria-labelledby="deleteCurrencyTitle" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form action="@Url.Action("DeleteCurrency", "Home")" method="post">
                @Html.AntiForgeryToken()

                <div class="modal-header">
                    <h5 class="modal-title" id="deleteCurrencyTitle">
                        Delete Currency
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>

                <div class="modal-body">
                    <input type="hidden" id="deleteCode" name="CurrencyCode" />
                    <p class="mb-0">Are you sure you want to delete <strong id="deleteCurrencyName"></strong> ?</p>
                </div>

                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times"></i> Cancel
                    </button>
                    <button type="submit" class="btn btn-danger">
                        <i class="fas fa-trash"></i> Delete
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
@section Scripts
{
    <script type="text/javascript">
        $(document).ready(async function () {

        });
    </script>
}