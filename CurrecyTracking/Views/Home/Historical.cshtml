@{
    ViewData["Title"] = "Historical Rates";
}
<div class="card mt-4">
    <div class="card-header">Historical Rates and Lookup · Base THB</div>
    <div class="card-body">
        <form id="lookupForm" class="row g-3">
            <div class="col-md-4">
                <label for="lookupType" class="form-label">Data</label>
                <select id="lookupType" class="form-select">
                    <option value="all">Latest rates — all currencies</option>
                    <option value="selected">Latest rates — selected currencies</option>
                    <option value="currencies">Supported currencies</option>
                    <option value="historical" selected>Historical rates</option>
                    <option value="history">Rate history</option>
                </select>
            </div>
            <div class="col-md-4" id="symbolsField" hidden>
                <label for="lookupSymbols" class="form-label">Currency codes (comma-separated)</label>
                <input id="lookupSymbols" class="form-control" value="USD,EUR,JPY" placeholder="USD,EUR,JPY" />
                <div class="form-text">Leave empty for all currencies in historical queries.</div>
            </div>
            <div class="col-md-4" id="dateField" hidden>
                <label for="lookupDate" class="form-label">Date / end date</label>
                <input id="lookupDate" class="form-control" type="date" />
            </div>
            <div class="col-md-4" id="startField" hidden>
                <label for="lookupStart" class="form-label">Start date</label>
                <input id="lookupStart" class="form-control" type="date" />
                <div class="form-text">Defaults to seven days before the end date.</div>
            </div>
            <div class="col-12"><button id="lookupButton" type="submit" class="btn btn-primary">Fetch data</button></div>
        </form>
        <div id="lookupMessage" class="mt-3" role="status"></div>
        <div class="table-responsive">
            <table id="lookupResults" class="table table-bordered mt-3" hidden>
                <thead></thead><tbody></tbody>
            </table>
        </div>
    </div>
</div>
@section Scripts
{
    <script type="text/javascript">
        $(document).ready(async function () {
            const today = new Date();
            $('#lookupDate').val(today.toISOString().slice(0, 10)).attr('max', today.toISOString().slice(0, 10));
            today.setUTCDate(today.getUTCDate() - 7);
            $('#lookupStart').val(today.toISOString().slice(0, 10));
            $('#lookupType').on('change', function () {
                const type = $(this).val();
                $('#symbolsField').prop('hidden', type === 'all' || type === 'currencies');
                $('#dateField').prop('hidden', type !== 'historical' && type !== 'history');
                $('#startField').prop('hidden', type !== 'history');
            });
            $('#lookupForm').on('submit', async function (event) {
                event.preventDefault();
                await lookupRates();
            });
            $('#lookupType').trigger('change');
        });

        async function fetchAllRates() {
            let currencies = {};
            await $.ajax({
                url: '@Url.Action("AllRates", "Home")',
                type: 'GET',
                data: {},
                dataType: 'json',
                cache: false,
                timeout: 20000,
                success: function (response) {
                    currencies = response;
                }
            });
            console.log(currencies);
            return currencies;
        }

        async function fetchSelectedRates(symbols) {
            let currencies = {};
            await $.ajax({
                url: '@Url.Action("SelectedRates", "Home")',
                type: 'GET',
                data: { symbols: symbols },
                dataType: 'json',
                cache: false,
                timeout: 20000,
                success: function (response) {
                    currencies = response;
                }
            });
            console.log(currencies);
            return currencies;
        }

        async function fetchAllCurrencies() {
            let currencies = {};
            await $.ajax({
                url: '@Url.Action("SupportedCurrencies", "Home")',
                type: 'GET',
                data: {},
                dataType: 'json',
                cache: false,
                timeout: 20000,
                success: function (response) {
                    currencies = response;
                }
            });
            console.log(currencies);
            return currencies;
        }

        async function fetchHistoricalRates(date, symbols) {
            let currencies = {};
            await $.ajax({
                url: '@Url.Action("HistoricalRates", "Home")',
                type: 'GET',
                data: { date: date, symbols: symbols },
                dataType: 'json',
                cache: false,
                timeout: 20000,
                success: function (response) {
                    currencies = response;
                }
            });
            console.log(currencies);
            return currencies;
        }

        async function fetchRateHistory(start, end, symbols) {
            let currencies = {};
            await $.ajax({
                url: '@Url.Action("RateHistory", "Home")',
                type: 'GET',
                data: { start: start, end: end, symbols: symbols },
                dataType: 'json',
                cache: false,
                timeout: 20000,
                success: function (response) {
                    currencies = response;
                }
            });
            console.log(currencies);
            return currencies;
        }

        async function lookupRates() {
            const type = $('#lookupType').val();
            const symbols = $('#lookupSymbols').val();
            const date = $('#lookupDate').val();
            const start = $('#lookupStart').val();
            $('#lookupButton').prop('disabled', true);
            $('#lookupResults').prop('hidden', true);
            $('#lookupMessage').text('Loading…');
            try {
                let result;
                switch (type) {
                    case 'all': result = await fetchAllRates(); break;
                    case 'selected': result = await fetchSelectedRates(symbols); break;
                    case 'currencies': result = await fetchAllCurrencies(); break;
                    case 'historical': result = await fetchHistoricalRates(date, symbols); break;
                    case 'history': result = await fetchRateHistory(start, date, symbols); break;
                }
                const table = $('#lookupResults');
                const header = $('<tr>');
                (type === 'currencies' ? ['Code', 'Currency name'] : ['Rate date', 'Code', 'Units per 1 THB'])
                    .forEach(label => header.append($('<th>').text(label)));
                table.find('thead').empty().append(header);
                const body = table.find('tbody').empty();
                const addRow = values => {
                    const row = $('<tr>');
                    values.forEach(value => row.append($('<td>').text(value)));
                    body.append(row);
                };
                if (type === 'currencies') {
                    Object.entries(result).sort().forEach(([code, name]) => addRow([code, name]));
                } else {
                    const dates = type === 'history' ? result.rates : { [result.date]: result.rates };
                    Object.entries(dates).sort().forEach(([rateDate, rates]) => {
                        Object.entries(rates).sort().forEach(([code, rate]) => addRow([rateDate, code, rate]));
                    });
                }
                table.prop('hidden', false);
                $('#lookupMessage').text('Data loaded. Dates shown are the actual published rate dates.');
            } catch (error) {
                $('#lookupMessage').text(error.responseJSON?.message || 'Unable to load data. Please try again.');
            } finally {
                $('#lookupButton').prop('disabled', false);
            }
        }

    </script>
}
